# Microservices Environment Variables

# Auth Service
AUTH_SERVICE_URL=http://localhost:8001
AUTH_SERVICE_GRPC_URL=localhost:50051

# User Service
USER_SERVICE_URL=http://localhost:8002
USER_SERVICE_GRPC_URL=localhost:50052

# Gateway Service
GATEWAY_URL=http://localhost:8000

# Databases
AUTH_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db
USER_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/user_db

# NATS
NATS_URL=nats://localhost:4222

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
